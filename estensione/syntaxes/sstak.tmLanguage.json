{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "SStak",
  "scopeName": "source.sstak",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.sstak",
          "begin": "\\^\\^",
          "end": "\\^\\^"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.other.input.sstak",
          "match": ":\\?[^?\\n]*\\?:"
        },
        {
          "name": "string.quoted.double.sstak",
          "match": ":[^:\\n]*:"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.sstak",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "support.function.sstak",
          "match": "\\b(REP|DUP|SHOW|DEL|DELALL|LOAD|REM|PICK|Stack)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arithmetic.sstak",
          "match": "\\+\\+|--|\\*\\*|//|[+\\-*/]"
        }
      ]
    }
  }
}
